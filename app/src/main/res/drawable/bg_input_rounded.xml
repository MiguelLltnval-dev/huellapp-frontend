<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado cuando el usuario hace clic o está escribiendo en el EditText -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/huellapp_card_bg"/>
            <corners android:radius="16dp"/>
            <!-- Borde naranja vibrante al enfocar -->
            <stroke android:width="2dp" android:color="@color/huellapp_primary"/>
        </shape>
    </item>

    <!-- Estado normal (inactivo) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/huellapp_card_bg"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="@color/huellapp_border"/>
        </shape>
    </item>
</selector>

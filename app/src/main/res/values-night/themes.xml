<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro también usa NoActionBar -->
    <style name="Base.Theme.HuellaApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/huellapp_primary</item>
        <item name="colorPrimaryVariant">@color/huellapp_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- En modo oscuro, el fondo debe ser más apagado, pero usamos variables unificadas -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/huellapp_text_dark</item>
    </style>
</resources>

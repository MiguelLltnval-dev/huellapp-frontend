<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/huellapp_background"
    android:fillViewport="true"
    tools:context=".MiPerfilActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/headerPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="48dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBackPerfil"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/huellapp_text_dark" />

            <TextView
                style="@style/HuellAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Mi Perfil"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="@color/huellapp_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TARJETA DE USUARIO -->
        <LinearLayout
            android:id="@+id/cardUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/headerPerfil">

            <!-- Avatar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar_verified"
                    android:padding="16dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/huellapp_blue" />

                <!-- Check Naranja -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar_verified"
                    android:backgroundTint="@color/white"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/huellapp_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvNombrePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cargando..."
                android:textColor="@color/huellapp_text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_verified"
                android:drawablePadding="4dp"
                android:text="Identidad Verificada Antifraude"
                android:textColor="@color/huellapp_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                app:drawableStartCompat="@android:drawable/checkbox_on_background"
                app:drawableTint="@color/huellapp_blue" />

            <TextView
                android:id="@+id/tvCiudadPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="8dp"
                android:text="Ciudad"
                android:textColor="@color/huellapp_text_hint"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                app:drawableTint="@color/huellapp_text_hint" />

            <TextView
                android:id="@+id/tvCorreoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:text="correo@ejemplo.com"
                android:textColor="@color/huellapp_text_hint"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_dialog_email"
                app:drawableTint="@color/huellapp_text_hint" />

            <TextView
                android:id="@+id/tvCelularPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:text="+57 000 000 0000"
                android:textColor="@color/huellapp_text_hint"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_menu_call"
                app:drawableTint="@color/huellapp_text_hint" />
        </LinearLayout>

        <!-- ESTADÍSTICAS -->
        <LinearLayout
            android:id="@+id/llStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cardUsuario">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/huellapp_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mascotas Reportadas"
                    android:textAlignment="center"
                    android:textColor="@color/huellapp_text_dark"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/huellapp_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pistas Aportadas"
                    android:textAlignment="center"
                    android:textColor="@color/huellapp_text_dark"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- OPCIONES DEL MENÚ -->
        <LinearLayout
            android:id="@+id/cardOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            app:layout_constraintTop_toBottomOf="@id/llStats">

            <!-- Opción: Mis Reportes Activos -->
            <TextView
                android:id="@+id/opcReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="Mis Reportes Activos"
                android:textColor="@color/huellapp_text_dark"
                android:textSize="15sp"
                app:drawableEndCompat="@android:drawable/ic_media_play"
                app:drawableStartCompat="@android:drawable/ic_menu_agenda"
                app:drawableTint="@color/huellapp_text_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:background="@color/huellapp_border" />

            <!-- Opción: Directorio Veterinario -->
            <TextView
                android:id="@+id/opcDirectorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="Directorio Veterinario (Próximamente)"
                android:textColor="@color/huellapp_text_dark"
                android:textSize="15sp"
                app:drawableEndCompat="@android:drawable/ic_media_play"
                app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                app:drawableTint="@color/huellapp_text_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:background="@color/huellapp_border" />

            <!-- Opción: Asistente IA -->
            <TextView
                android:id="@+id/opcAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="Asistente HuellApp (IA)"
                android:textColor="@color/huellapp_text_dark"
                android:textSize="15sp"
                app:drawableEndCompat="@android:drawable/ic_media_play"
                app:drawableStartCompat="@android:drawable/ic_btn_speak_now"
                app:drawableTint="@color/huellapp_text_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:background="@color/huellapp_border" />

            <!-- Opción: Editar Perfil -->
            <TextView
                android:id="@+id/opcEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="Editar Perfil"
                android:textColor="@color/huellapp_text_dark"
                android:textSize="15sp"
                app:drawableEndCompat="@android:drawable/ic_media_play"
                app:drawableStartCompat="@android:drawable/ic_menu_edit"
                app:drawableTint="@color/huellapp_text_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:background="@color/huellapp_border" />

            <!-- Opción: Configuración y Privacidad -->
            <TextView
                android:id="@+id/opcConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="Configuración y Privacidad"
                android:textColor="@color/huellapp_text_dark"
                android:textSize="15sp"
                app:drawableEndCompat="@android:drawable/ic_media_play"
                app:drawableStartCompat="@android:drawable/ic_menu_preferences"
                app:drawableTint="@color/huellapp_text_hint" />
        </LinearLayout>

        <!-- BOTÓN CERRAR SESIÓN -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_outline_red"
            android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
            android:drawablePadding="12dp"
            android:drawableTint="@color/huellapp_red"
            android:paddingHorizontal="24dp"
            android:text="Cerrar Sesión"
            android:textAllCaps="false"
            android:textColor="@color/huellapp_red"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardOpciones" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- MENSAJE DE LA IA -->
    <LinearLayout
        android:id="@+id/llAiMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_dialog_info"
            android:background="@drawable/bg_avatar_verified"
            android:padding="6dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvAiText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai"
            android:padding="12dp"
            android:text="Respuesta IA"
            android:textColor="@color/huellapp_text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- MENSAJE DEL USUARIO -->
    <LinearLayout
        android:id="@+id/llUserMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_user"
            android:padding="12dp"
            android:text="Mensaje Usuario"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
